# Supabase (progetto condiviso con stayio.it). Solo lato server: il sito
# usa esclusivamente il client con service role, mai la anon key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notifiche email a Stayio (nuove richieste, aggiornamenti concierge).
# Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=stayio267@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Dominio pubblico, usato per metadataBase / Open Graph, robots.txt e
# sitemap.xml. Facoltativa: se manca vale https://www.stayio.info.
# NEXT_PUBLIC_SITE_URL=https://www.stayio.info

# Chiave per l'hash degli IP nel rate limit dei form. Facoltativa: se
# manca si usa la service role key.
# RATE_LIMIT_IP_SALT=una-stringa-casuale-lunga
